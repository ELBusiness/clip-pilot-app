# Google Cloud OAuth credentials (Desktop/Web application with the callback below)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# TikTok Login Kit + Content Posting API app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback

# Meta app using Instagram API with Instagram Login
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_GRAPH_VERSION=v25.0

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Optional binary locations. Defaults: ffmpeg and ffprobe on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Upload constraints
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_SECONDS=180
